class VehiculeForm(forms.ModelForm):
    class Meta:
        model = Vehicule

        fields = [
            "vehicule",
            "type_vehicule",
            "chauffeur",
            "date_debut",
            "date_fin",
            "kilometrage_initial",
            "kilometrage_final",
            "consommation_km_litre",
            "heures_initiales",
            "heures_finales",
            "consommation_heure_litre",
            "actif",
            "observation",
        ]

        widgets = {
            "vehicule": forms.TextInput(
                attrs={
                    "class": "form-control",
                    "placeholder": "Exemple : Camion 01",
                }
            ),
            "type_vehicule": forms.Select(
                attrs={"class": "form-select"}
            ),
            "chauffeur": forms.Select(
                attrs={"class": "form-select"}
            ),
            "date_debut": forms.DateInput(
                attrs={
                    "class": "form-control",
                    "type": "date",
                }
            ),
            "date_fin": forms.DateInput(
                attrs={
                    "class": "form-control",
                    "type": "date",
                }
            ),
            "kilometrage_initial": forms.NumberInput(
                attrs={
                    "class": "form-control",
                    "step": "0.01",
                    "min": "0",
                }
            ),
            "kilometrage_final": forms.NumberInput(
                attrs={
                    "class": "form-control",
                    "step": "0.01",
                    "min": "0",
                }
            ),
            "consommation_km_litre": forms.NumberInput(
                attrs={
                    "class": "form-control",
                    "step": "0.01",
                    "min": "0",
                    "placeholder": "Exemple : 3.50",
                }
            ),
            "heures_initiales": forms.NumberInput(
                attrs={
                    "class": "form-control",
                    "step": "0.01",
                    "min": "0",
                }
            ),
            "heures_finales": forms.NumberInput(
                attrs={
                    "class": "form-control",
                    "step": "0.01",
                    "min": "0",
                }
            ),
            "consommation_heure_litre": forms.NumberInput(
                attrs={
                    "class": "form-control",
                    "step": "0.01",
                    "min": "0",
                }
            ),
            "actif": forms.CheckboxInput(
                attrs={"class": "form-check-input"}
            ),
            "observation": forms.Textarea(
                attrs={
                    "class": "form-control",
                    "rows": 3,
                }
            ),
        }

        labels = {
            "vehicule": "VÃ©hicule / Engin",
            "type_vehicule": "Type de vÃ©hicule",
            "chauffeur": "Conducteur / Chauffeur",
            "date_debut": "DÃ©but de l'affectation",
            "date_fin": "Fin de l'affectation",
            "kilometrage_initial": "KilomÃ©trage initial",
            "kilometrage_final": "KilomÃ©trage final",
            "consommation_km_litre": "Consommation (km/L)",
            "heures_initiales": "Heures initiales",
            "heures_finales": "Heures finales",
            "consommation_heure_litre": "Consommation (L/h)",
            "actif": "Affectation active",
            "observation": "Observation",
        }

    def __init__(self, *args, projet=None, **kwargs):
        super().__init__(*args, **kwargs)

        # ConservÃ© pour compatibilitÃ© avec les vues existantes.
        # Le modÃ¨le materiels.Vehicule ne possÃ¨de pas de FK projet.
        self.projet = projet

        self.fields["chauffeur"].queryset = (
            Personnel.objects.filter(
                typeTravail="Construction"
            ).order_by("nom", "prenom")
        )
        self.fields["chauffeur"].required = False

        # Les dates du projet ne sont appliquÃ©es que si la vue
        # fournit un projet, sans supposer que le modÃ¨le y est liÃ©.
        if projet:
            if getattr(projet, "date_debut", None):
                self.fields["date_debut"].widget.attrs["min"] = (
                    projet.date_debut.isoformat()
                )
                self.fields["date_fin"].widget.attrs["min"] = (
                    projet.date_debut.isoformat()
                )

            if getattr(projet, "date_fin", None):
                self.fields["date_debut"].widget.attrs["max"] = (
                    projet.date_fin.isoformat()
                )
                self.fields["date_fin"].widget.attrs["max"] = (
                    projet.date_fin.isoformat()
                )

        if not self.instance.pk:
            if projet:
                if getattr(projet, "date_debut", None):
                    self.fields["date_debut"].initial = projet.date_debut

                if getattr(projet, "date_fin", None):
                    self.fields["date_fin"].initial = projet.date_fin

            self.fields["actif"].initial = True

    def clean_vehicule(self):
        vehicule = self.cleaned_data.get("vehicule", "")
        vehicule = vehicule.strip() if vehicule else ""

        if not vehicule:
            raise forms.ValidationError(
                "Veuillez saisir le vÃ©hicule."
            )

        return vehicule

    def clean(self):
        cleaned_data = super().clean()

        date_debut = cleaned_data.get("date_debut")
        date_fin = cleaned_data.get("date_fin")
        kilometrage_initial = cleaned_data.get("kilometrage_initial")
        kilometrage_final = cleaned_data.get("kilometrage_final")
        heures_initiales = cleaned_data.get("heures_initiales")
        heures_finales = cleaned_data.get("heures_finales")
        consommation_km = cleaned_data.get("consommation_km_litre")
        consommation_heure = cleaned_data.get("consommation_heure_litre")

        if date_debut and date_fin and date_fin < date_debut:
            self.add_error(
                "date_fin",
                "La fin de l'affectation doit Ãªtre postÃ©rieure "
                "ou Ã©gale au dÃ©but.",
            )

        if self.projet:
            projet_debut = getattr(self.projet, "date_debut", None)
            projet_fin = getattr(self.projet, "date_fin", None)

            if date_debut and projet_debut and date_debut < projet_debut:
                self.add_error(
                    "date_debut",
                    "L'affectation ne peut pas commencer avant "
                    "le dÃ©but du projet.",
                )

            if date_fin and projet_fin and date_fin > projet_fin:
                self.add_error(
                    "date_fin",
                    "L'affectation ne peut pas dÃ©passer "
                    "la date de fin du projet.",
                )

        if (
            kilometrage_initial is not None
            and kilometrage_initial < 0
        ):
            self.add_error(
                "kilometrage_initial",
                "Le kilomÃ©trage initial ne peut pas Ãªtre nÃ©gatif.",
            )

        if (
            kilometrage_final is not None
            and kilometrage_final < 0
        ):
            self.add_error(
                "kilometrage_final",
                "Le kilomÃ©trage final ne peut pas Ãªtre nÃ©gatif.",
            )

        if (
            kilometrage_initial is not None
            and kilometrage_final is not None
            and kilometrage_final < kilometrage_initial
        ):
            self.add_error(
                "kilometrage_final",
                "Le kilomÃ©trage final doit Ãªtre supÃ©rieur "
                "ou Ã©gal au kilomÃ©trage initial.",
            )

        if heures_initiales is not None and heures_initiales < 0:
            self.add_error(
                "heures_initiales",
                "Les heures initiales ne peuvent pas Ãªtre nÃ©gatives.",
            )

        if heures_finales is not None and heures_finales < 0:
            self.add_error(
                "heures_finales",
                "Les heures finales ne peuvent pas Ãªtre nÃ©gatives.",
            )

        if (
            heures_initiales is not None
            and heures_finales is not None
            and heures_finales < heures_initiales
        ):
            self.add_error(
                "heures_finales",
                "Les heures finales doivent Ãªtre supÃ©rieures "
                "ou Ã©gales aux heures initiales.",
            )

        if consommation_km is not None and consommation_km < 0:
            self.add_error(
                "consommation_km_litre",
                "La consommation (km/L) ne peut pas Ãªtre nÃ©gative.",
            )

        if consommation_heure is not None and consommation_heure < 0:
            self.add_error(
                "consommation_heure_litre",
                "La consommation (L/h) ne peut pas Ãªtre nÃ©gative.",
            )

        return cleaned_data


