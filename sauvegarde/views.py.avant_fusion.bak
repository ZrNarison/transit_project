import hashlib
import json
import logging
import os
import tempfile
import uuid
from datetime import datetime, timezone
from pathlib import Path

from cryptography.fernet import Fernet, InvalidToken
from django.apps import apps
from django.conf import settings
from django.contrib import messages
from django.core import serializers
from django.core.exceptions import ImproperlyConfigured, ObjectDoesNotExist
from django.db import DEFAULT_DB_ALIAS, IntegrityError, transaction
from django.http import FileResponse, HttpResponseBadRequest
from django.shortcuts import redirect, render
from django.utils import timezone as django_timezone
from django.utils.text import get_valid_filename
from django.views.decorators.cache import never_cache
from django.views.decorators.http import require_POST, require_http_methods

from .models import JournalSauvegarde

logger = logging.getLogger(__name__)

FORMAT_NAME = "TRANSIT_PROJECT_SECURE_BACKUP"
FORMAT_VERSION = 1
MAX_UPLOAD_BYTES = 100 * 1024 * 1024
SESSION_TOKEN_KEY = "transit_sauvegarde_import_token"
STAGING_DIR_NAME = ".private_imports"
EXCLUDED_MODELS = {
    "sessions.session",
    "admin.logentry",
}
FIXTURE_EXCLUDES = ("sessions", "admin.logentry")


class BackupValidationError(Exception):
    """Erreur de validation contrôlée d'une sauvegarde."""


def _fernet():
    key = os.environ.get("TRANSIT_BACKUP_KEY", "").strip()
    if not key:
        raise ImproperlyConfigured(
            "La variable d'environnement TRANSIT_BACKUP_KEY n'est pas configurée."
        )
    try:
        return Fernet(key.encode("ascii"))
    except (ValueError, UnicodeEncodeError) as exc:
        raise ImproperlyConfigured(
            "TRANSIT_BACKUP_KEY doit contenir une clé Fernet valide."
        ) from exc


def _project_fingerprint():
    secret = str(getattr(settings, "SECRET_KEY", ""))
    if not secret:
        raise ImproperlyConfigured("SECRET_KEY n'est pas configurée.")
    return hashlib.sha256(secret.encode("utf-8")).hexdigest()


def _actor(request):
    """Accepte les sessions GALAXY et H/MCCR connues du projet."""
    try:
        from users.models import AppUser, H_AppUser
    except (ImportError, RuntimeError):
        AppUser = H_AppUser = None

    if request.user.is_authenticated:
        return {
            "id": str(request.user.pk),
            "name": str(request.user.get_username()),
            "session": "django_auth",
        }

    user_id = request.session.get("user_id")
    if user_id and AppUser is not None:
        user = AppUser.objects.filter(pk=user_id).first()
        if user is not None:
            return {
                "id": str(user.pk),
                "name": str(
                    getattr(user, "username", "")
                    or getattr(user, "nom_utilisateur", "")
                    or request.session.get("username", "")
                    or f"Utilisateur {user.pk}"
                ),
                "session": "GALAXY",
            }

    h_user_id = request.session.get("h_user_id")
    if h_user_id and H_AppUser is not None:
        user = H_AppUser.objects.filter(pk=h_user_id).first()
        if user is not None:
            return {
                "id": str(user.pk),
                "name": str(
                    getattr(user, "username", "")
                    or getattr(user, "nom_utilisateur", "")
                    or request.session.get("h_username", "")
                    or f"Utilisateur H {user.pk}"
                ),
                "session": "H/MCCR",
            }
    return None


def _require_actor(request):
    actor = _actor(request)
    if actor is None:
        messages.error(
            request,
            "Session invalide ou expirée. Veuillez vous reconnecter.",
        )
        return None
    return actor


def _journal(actor, action, statut="OK", fichier="", empreinte="", details=""):
    try:
        JournalSauvegarde.objects.create(
            utilisateur_id=(actor or {}).get("id", ""),
            utilisateur=(actor or {}).get("name", "Inconnu")[:150],
            source_session=(actor or {}).get("session", "")[:30],
            action=action,
            statut=statut[:20],
            fichier=fichier[:255],
            empreinte_sha256=empreinte[:64],
            details=str(details)[:4000],
        )
    except Exception:
        # L'échec du journal ne doit jamais révéler les données ou la clé.
        logger.exception("Impossible d'écrire le journal de sauvegarde.")


def _staging_dir():
    # Répertoire privé hors static/ et media/. Ne pas publier ce dossier.
    path = Path(settings.BASE_DIR) / STAGING_DIR_NAME
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


def _clear_staged_import(request):
    token = request.session.pop(SESSION_TOKEN_KEY, None)
    if not token or not isinstance(token, str):
        return
    # Le nom du fichier est construit côté serveur à partir d'un UUID.
    try:
        uuid.UUID(token)
        (_staging_dir() / f"{token}.enc").unlink(missing_ok=True)
    except (ValueError, OSError):
        logger.warning("Impossible de nettoyer un fichier d'import temporaire.")


def _build_fixture():
    # dumpdata trie les dépendances et utilise les clés naturelles.
    from django.core.management import call_command
    from io import StringIO

    output = StringIO()
    call_command(
        "dumpdata",
        "--natural-foreign",
        "--natural-primary",
        "--exclude=sessions",
        "--exclude=admin.logentry",
        "--indent=2",
        stdout=output,
        verbosity=0,
    )
    return output.getvalue()


def _make_encrypted_archive():
    payload = {
        "format": FORMAT_NAME,
        "version": FORMAT_VERSION,
        "project_fingerprint": _project_fingerprint(),
        "created_at": django_timezone.now().isoformat(),
        "django_version": str(getattr(settings, "DJANGO_VERSION", "")),
        "fixture": _build_fixture(),
    }
    raw = json.dumps(
        payload,
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    encrypted = _fernet().encrypt(raw)
    return encrypted, hashlib.sha256(encrypted).hexdigest(), payload["created_at"]


def _read_and_validate_archive(encrypted):
    if not encrypted or len(encrypted) > MAX_UPLOAD_BYTES:
        raise BackupValidationError(
            "Fichier vide ou trop volumineux (limite : 100 Mo)."
        )
    try:
        raw = _fernet().decrypt(encrypted)
    except InvalidToken as exc:
        raise BackupValidationError(
            "Archive invalide, altérée ou chiffrée avec une autre clé."
        ) from exc

    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise BackupValidationError("Le contenu déchiffré n'est pas un JSON valide.") from exc

    if not isinstance(payload, dict):
        raise BackupValidationError("Format d'archive incorrect.")
    if payload.get("format") != FORMAT_NAME:
        raise BackupValidationError("Cette archive n'est pas une sauvegarde TRANSIT_PROJECT.")
    if payload.get("version") != FORMAT_VERSION:
        raise BackupValidationError("Version d'archive non prise en charge.")
    if payload.get("project_fingerprint") != _project_fingerprint():
        raise BackupValidationError(
            "Cette sauvegarde appartient à une installation ayant une autre SECRET_KEY."
        )
    fixture = payload.get("fixture")
    if not isinstance(fixture, str) or not fixture.strip():
        raise BackupValidationError("La sauvegarde ne contient aucune fixture exploitable.")
    try:
        parsed = json.loads(fixture)
    except json.JSONDecodeError as exc:
        raise BackupValidationError("La fixture JSON est invalide.") from exc
    if not isinstance(parsed, list):
        raise BackupValidationError("La fixture doit contenir une liste d'enregistrements.")
    return payload, parsed


def _model_for_label(label):
    try:
        model = apps.get_model(label)
    except (LookupError, ValueError) as exc:
        raise BackupValidationError(f"Modèle inconnu dans l'archive : {label}.") from exc
    if model is None or model._meta.proxy or model._meta.swapped:
        raise BackupValidationError(f"Modèle non importable : {label}.")
    if model._meta.label_lower in EXCLUDED_MODELS:
        raise BackupValidationError(f"Modèle interdit dans l'archive : {label}.")
    return model


def _same_record(existing, incoming_obj, m2m_data):
    for field in existing._meta.concrete_fields:
        if getattr(existing, field.attname) != getattr(incoming_obj, field.attname):
            return False
    for field_name, incoming_values in (m2m_data or {}).items():
        manager = getattr(existing, field_name)
        current_ids = set(manager.values_list("pk", flat=True))
        incoming_ids = set(
            getattr(value, "pk", value)
            for value in incoming_values
        )
        if current_ids != incoming_ids:
            return False
    return True


def _inspect_fixture(fixture_text):
    """Désérialise et détecte les collisions sans écrire dans la base."""
    from django.core.serializers.base import DeserializationError

    try:
        deserialized = list(serializers.deserialize(
            "json",
            fixture_text,
            ignorenonexistent=False,
            handle_forward_references=True,
        ))
    except Exception as exc:
        raise BackupValidationError(
            f"Les données ou relations de l'archive sont invalides : {exc}"
        ) from exc

    new_count = 0
    identical_count = 0
    collisions = []
    for item in deserialized:
        model = item.object.__class__
        _model_for_label(model._meta.label)
        if item.object.pk is None:
            # Les objets sans PK sont possibles pour les modèles à clé naturelle.
            lookup = None
            if hasattr(item.object, "natural_key"):
                try:
                    natural = item.object.natural_key()
                    lookup = model._default_manager.get_by_natural_key(*natural)
                except (ObjectDoesNotExist, AttributeError, TypeError):
                    lookup = None
            if lookup is not None:
                if _same_record(lookup, item.object, item.m2m_data):
                    identical_count += 1
                    continue
                collisions.append(model._meta.label)
            else:
                new_count += 1
            continue

        existing = model._default_manager.filter(pk=item.object.pk).first()
        if existing is None:
            new_count += 1
        elif _same_record(existing, item.object, item.m2m_data):
            identical_count += 1
        else:
            collisions.append(f"{model._meta.label} (ID {item.object.pk})")

    if collisions:
        examples = ", ".join(collisions[:8])
        raise BackupValidationError(
            "Conflits d'identifiants : certains enregistrements existants "
            "diffèrent de ceux de la sauvegarde. Aucun changement n'a été effectué. "
            f"Exemples : {examples}"
        )
    return deserialized, new_count, identical_count


def _import_fixture(fixture_text):
    """Ajoute les objets absents ; n'écrase jamais un objet existant."""
    deserialized, new_count, identical_count = _inspect_fixture(fixture_text)
    alias = DEFAULT_DB_ALIAS

    # Refaire la vérification et l'import dans une transaction atomique.
    created = 0
    skipped = 0
    with transaction.atomic(using=alias):
        pending = []
        for item in deserialized:
            model = item.object.__class__
            existing = None
            if item.object.pk is not None:
                existing = model._default_manager.using(alias).filter(
                    pk=item.object.pk
                ).first()
            elif hasattr(item.object, "natural_key"):
                try:
                    natural = item.object.natural_key()
                    existing = model._default_manager.using(alias).get_by_natural_key(*natural)
                except (ObjectDoesNotExist, AttributeError, TypeError):
                    existing = None

            if existing is not None:
                if _same_record(existing, item.object, item.m2m_data):
                    skipped += 1
                    continue
                raise BackupValidationError(
                    f"Conflit détecté sur {model._meta.label}; import annulé."
                )

            # Force INSERT : un PK existant ne sera jamais mis à jour.
            item.save(using=alias, force_insert=True, save_m2m=False)
            pending.append(item)
            created += 1

        # Les FK en avant peuvent être différées par le désérialiseur.
        for item in pending:
            if getattr(item, "deferred_fields", None):
                item.save_deferred_fields(using=alias)

        # Appliquer les relations M2M après insertion des objets.
        for item in pending:
            for field_name, related_values in (item.m2m_data or {}).items():
                getattr(item.object, field_name).set(related_values)

    return created, skipped, new_count, identical_count


@never_cache
@require_http_methods(["GET"])
def index(request):
    actor = _require_actor(request)
    if actor is None:
        return redirect("users:login")

    journal = JournalSauvegarde.objects.order_by("-date_operation")[:30]
    pending_token = request.session.get(SESSION_TOKEN_KEY)
    pending_exists = False
    if pending_token:
        try:
            uuid.UUID(pending_token)
            pending_exists = (_staging_dir() / f"{pending_token}.enc").is_file()
        except ValueError:
            request.session.pop(SESSION_TOKEN_KEY, None)

    return render(
        request,
        "sauvegarde/index.html",
        {
            "journal_sauvegardes": journal,
            "pending_import": pending_exists,
        },
    )


@never_cache
@require_POST
def exporter(request):
    actor = _require_actor(request)
    if actor is None:
        return redirect("users:login")

    try:
        encrypted, digest, created_at = _make_encrypted_archive()
        _journal(
            actor,
            "EXPORT",
            fichier="transit_project.transitbak",
            empreinte=digest,
            details=f"Archive chiffrée créée le {created_at}.",
        )
        response = FileResponse(
            iter([encrypted]),
            content_type="application/octet-stream",
            as_attachment=True,
            filename=f"transit_project_{django_timezone.now():%Y%m%d_%H%M%S}.transitbak",
        )
        response["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
        response["Pragma"] = "no-cache"
        response["X-Content-Type-Options"] = "nosniff"
        return response
    except Exception as exc:
        logger.exception("Échec de l'exportation sécurisée.")
        _journal(actor, "ERROR", statut="ECHEC", details=f"Export : {type(exc).__name__}")
        messages.error(request, f"Exportation impossible : {exc}")
        return redirect("sauvegarde:index")


@never_cache
@require_POST
def valider_import(request):
    actor = _require_actor(request)
    if actor is None:
        return redirect("users:login")

    uploaded = request.FILES.get("fichier_sauvegarde")
    if uploaded is None:
        messages.error(request, "Choisissez une archive à vérifier.")
        return redirect("sauvegarde:index")
    if uploaded.size <= 0 or uploaded.size > MAX_UPLOAD_BYTES:
        messages.error(request, "Le fichier est vide ou dépasse la limite de 100 Mo.")
        return redirect("sauvegarde:index")

    try:
        encrypted = uploaded.read(MAX_UPLOAD_BYTES + 1)
        if len(encrypted) > MAX_UPLOAD_BYTES:
            raise BackupValidationError("Fichier trop volumineux (limite : 100 Mo).")
        payload, _parsed = _read_and_validate_archive(encrypted)
        _deserialized, new_count, identical_count = _inspect_fixture(payload["fixture"])

        _clear_staged_import(request)
        token = str(uuid.uuid4())
        staged_path = _staging_dir() / f"{token}.enc"
        staged_path.write_bytes(encrypted)
        try:
            os.chmod(staged_path, 0o600)
        except OSError:
            pass
        request.session[SESSION_TOKEN_KEY] = token
        request.session.modified = True

        digest = hashlib.sha256(encrypted).hexdigest()
        _journal(
            actor,
            "PREVIEW",
            fichier=get_valid_filename(uploaded.name)[:255],
            empreinte=digest,
            details=f"Validation réussie. Nouveaux : {new_count}; identiques : {identical_count}.",
        )
        messages.success(
            request,
            f"Archive authentifiée et valide. Nouveaux enregistrements estimés : "
            f"{new_count}; enregistrements identiques ignorés : {identical_count}. "
            "Confirmez l'importation ci-dessous.",
        )
    except (BackupValidationError, ImproperlyConfigured) as exc:
        _journal(actor, "ERROR", statut="INVALIDE", fichier=get_valid_filename(uploaded.name), details=str(exc))
        messages.error(request, str(exc))
    except Exception as exc:
        logger.exception("Erreur lors de la validation de l'archive.")
        _journal(actor, "ERROR", statut="ECHEC", fichier=get_valid_filename(uploaded.name), details=type(exc).__name__)
        messages.error(request, f"Validation impossible : {type(exc).__name__}. Consultez le journal serveur.")

    return redirect("sauvegarde:index")


@never_cache
@require_POST
def importer(request):
    actor = _require_actor(request)
    if actor is None:
        return redirect("users:login")

    token = request.session.get(SESSION_TOKEN_KEY)
    if not token:
        messages.error(request, "Aucune archive validée en attente. Importez et validez un fichier.")
        return redirect("sauvegarde:index")

    try:
        uuid.UUID(token)
        staged_path = _staging_dir() / f"{token}.enc"
        encrypted = staged_path.read_bytes()
        payload, _parsed = _read_and_validate_archive(encrypted)

        
        # Sauvegarde préalable de la base SQLite avant toute écriture.
        db_config = settings.DATABASES.get(DEFAULT_DB_ALIAS, {})
        engine = db_config.get("ENGINE", "")
        backup_path = None

        if engine.endswith("sqlite3"):
            db_name = db_config.get("NAME")

            if db_name and str(db_name) != ":memory:":
                from django.db import connections

                connection = connections[DEFAULT_DB_ALIAS]
                connection.ensure_connection()

                # Générer un chemin unique qui n'existe pas encore.
                backup_name = (
                    f"transit_avant_import_"
                    f"{django_timezone.now():%Y%m%d_%H%M%S}_"
                    f"{uuid.uuid4().hex}.sqlite3"
                )
                backup_path = str(Path(settings.BASE_DIR) / backup_name)

                # Finaliser les écritures WAL avant la copie.
                with connection.cursor() as cursor:
                    cursor.execute("PRAGMA wal_checkpoint(FULL)")

                    # Le fichier de destination doit être inexistant.
                    cursor.execute("VACUUM INTO %s", [backup_path])

                try:
                    os.chmod(backup_path, 0o600)
                except OSError:
                    pass


        created, skipped, _new_estimate, _same_estimate = _import_fixture(payload["fixture"])
        digest = hashlib.sha256(encrypted).hexdigest()
        _journal(
            actor,
            "IMPORT",
            fichier=staged_path.name,
            empreinte=digest,
            details=f"Import fusion réussi. Ajoutés : {created}; identiques ignorés : {skipped}; sauvegarde préalable : {backup_path or 'non applicable'}.",
        )
        messages.success(
            request,
            f"Importation terminée. {created} enregistrement(s) ajouté(s), "
            f"{skipped} enregistrement(s) identique(s) ignoré(s). "
            + (f"Sauvegarde préalable : {Path(backup_path).name}." if backup_path else ""),
        )
    except (BackupValidationError, ImproperlyConfigured) as exc:
        _journal(actor, "ERROR", statut="INVALIDE", details=str(exc))
        messages.error(request, str(exc))
    except IntegrityError:
        logger.exception("Contrainte de base lors de l'import fusion.")
        _journal(actor, "ERROR", statut="ANNULE", details="Contrainte d'intégrité : transaction annulée.")
        messages.error(
            request,
            "Importation annulée : une contrainte d'intégrité ou une valeur unique est en conflit. "
            "Aucune insertion de cette transaction n'a été conservée.",
        )
    except Exception as exc:
        logger.exception("Échec de l'importation sécurisée.")
        _journal(actor, "ERROR", statut="ECHEC", details=f"Import : {type(exc).__name__}")
        messages.error(
            request,
            f"Importation impossible ({type(exc).__name__}). La transaction a été annulée si elle avait commencé.",
        )
    finally:
        _clear_staged_import(request)

    return redirect("sauvegarde:index")
